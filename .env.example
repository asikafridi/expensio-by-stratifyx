# ───────────── Expensio · StratifyX Global ─────────────
# Run `npm run setup` to create .env with fresh random secrets automatically.

NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
# Comma-separated list of extra allowed origins (e.g. a future mobile web view / separate admin domain)
CORS_ORIGINS=

# MongoDB (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/expensio

# Secrets – NEVER commit real values. Generate with: npm run setup
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# 32 bytes, hex (64 chars). Used for AES-256-GCM encryption of NID numbers + HMAC blind index.
ENCRYPTION_KEY=

# Email (required in production). In development, if SMTP_HOST is empty,
# emails are printed to the console and saved to ./.dev-mail/*.html
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Expensio <no-reply@expensio.app>"

# First Super Admin (created by `npm run seed`)
SEED_ADMIN_EMAIL=admin@expensio.local
SEED_ADMIN_PASSWORD=ChangeMe!12345

# Optional JSON override of FX rates per 1 USD, e.g. {"BDT":123.5}
FX_RATES_JSON=
